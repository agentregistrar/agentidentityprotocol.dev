---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SourceBanner from "../components/SourceBanner.astro";
import { SPEC_REPO_URL } from "../site.config";

const entry = await getEntry("generated", "releases");
if (!entry) {
  throw new Error('Missing generated content entry "releases"');
}

const { Content, headings } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath="/releases/"
  headings={headings}
  tocMaxDepth={2}
>
  <h1>Release history</h1>
  <p class="status-line">
    Tagged releases and source archives:{" "}
    <a href={`${SPEC_REPO_URL}/tags`}>{SPEC_REPO_URL}/tags</a>
  </p>

  <SourceBanner
    specTag={entry.data.specTag}
    wireVersion={entry.data.wireVersion}
    releaseDate={entry.data.releaseDate}
    commit={entry.data.commit}
    sourcePath={entry.data.sourcePath}
    rawMarkdownPath="/releases.md"
  />

  <Content />
</Layout>
